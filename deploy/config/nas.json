{
  "id": "nas",
  "raft_listen": "0.0.0.0:7000",
  "http_listen": "0.0.0.0:8080",
  "initial_cluster": {
    "nas": {
      "raft": "10.0.0.10:7000",
      "http": "10.0.0.10:8080"
    },
    "pi5": {
      "raft": "10.0.0.11:7000",
      "http": "10.0.0.11:8080"
    },
    "server": {
      "raft": "10.0.0.12:7000",
      "http": "10.0.0.12:8080"
    }
  },
  "join": false,
  "tick_ms": 100,
  "election_ticks": 10,
